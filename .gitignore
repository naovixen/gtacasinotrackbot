# Your own screen boxes: pixel coordinates in one particular window at one
# particular size, so they are per-machine. insidetrack.example.toml is the
# committed template; `python -m insidetrack setup` writes this one.
insidetrack.toml
.insidetrack.toml

# Everything the bot generates and can regenerate: the calibration captures
# (calibrate.png, probe.png), the setup wizard's shots (setup-*.png) and the
# --debug-images crops. Safe to delete the whole directory at any time.
out/

# race_log.csv itself is committed -- it is the record the strategy is
# measured against -- but the rotated copies racelog.py leaves beside it are
# per-run and yours alone.
data/*.old.csv

__pycache__/
*.py[cod]
.venv/
venv/

# The strategy author's Reddit posts and charts: theirs, not ours to publish.
# analysis/ reads SecondPost.md from here; see docs/strategy.md.
post-info/
